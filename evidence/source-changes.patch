+/* Shared accessibility adjustments; retain the existing layout and palette. */
+.skip-link {
+    position: absolute;
+    left: 1rem;
+    top: -8rem;
+    z-index: 10000;
+    padding: .75rem 1rem;
+    color: #fff;
+    background: #111;
+}
+.skip-link:focus { top: 1rem; color: #fff; }
+:focus-visible { outline: 3px solid #005fcc !important; outline-offset: 3px; }
+#main-content:focus { outline: 3px solid #005fcc; outline-offset: -3px; }
+.footer :focus-visible, .bg-dark :focus-visible {
+    outline-color: #fff !important;
+    box-shadow: 0 0 0 6px #111;
+}
+.text-muted, .text-gray-350, .text-gray-400, .text-gray-500 { color: #595959 !important; }
+a { color: #b53b32; }
+a:hover { color: #963129; }
+.text-primary, .nav-link.active { color: #b53b32 !important; }
+.card-circle { background-color: #b53b32; }
+.btn-primary { background-color: #b53b32; border-color: #b53b32; }
+.btn-primary:hover, .btn-primary:focus { background-color: #963129; border-color: #963129; }
+.btn-white-primary:hover, .btn-white-primary:focus { background-color: #b53b32; color: #fff; }
+.form-control-gray-700::placeholder { color: #ddd; opacity: 1; }
+.form-control, .custom-select { border-color: #757575; }
+.custom-control-label::before { border-color: #757575; }
+.custom-control-input:focus-visible ~ .custom-control-label::before {
+    outline: 3px solid #005fcc;
+    outline-offset: 3px;
+}
+h1.contactus { font-size: 2.25rem; font-weight: 500; line-height: 1.2; }
+.card-img-overlay p { background: #111; padding: .25rem .5rem; }
+.product-title { font-size: 1rem; line-height: inherit; margin-bottom: 0; }
+blockquote { margin: 0; }
+figure { margin-left: 0; margin-right: 0; }
+/* These static pages have no collapse script: keep navigation available. */
+@media (max-width: 991.98px) {
+    #navbarCollapse { display: flex; flex-wrap: wrap; }
+    #navbarCollapse .navbar-nav { flex-direction: row; flex-wrap: wrap; }
+}
